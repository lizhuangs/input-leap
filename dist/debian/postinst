#!/bin/sh
set -e

case "$1" in
    configure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl enable input-leap.service >/dev/null 2>&1 || true
            systemctl try-restart input-leap.service >/dev/null 2>&1 || \
                systemctl try-start input-leap.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
