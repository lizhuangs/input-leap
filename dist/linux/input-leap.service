[Unit]
Description=Input Leap packaged system service
After=display-manager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecCondition=/usr/bin/input-leap-systemd-service --has-config
ExecStart=/usr/bin/input-leap-systemd-service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
