if (UNIX)
    set(CPACK_PACKAGE_VERSION_MAJOR ${INPUTLEAP_VERSION_MAJOR})
    set(CPACK_PACKAGE_VERSION_MINOR ${INPUTLEAP_VERSION_MINOR})
    set(CPACK_PACKAGE_VERSION_PATCH ${INPUTLEAP_VERSION_PATCH})
    set(CPACK_GENERATOR "TBZ2")
    set(CPACK_SOURCE_GENERATOR "TXZ")
    set(CPACK_SOURCE_IGNORE_FILES "/build/;\.gitignore$;/\.git/;/.github/;\.swp$;build_env\.*")
    set(CPACK_PACKAGE_VENDOR "InputLeap Developers")
    set(CPACK_PACKAGE_CONTACT "Povilas Kanapickas <povilas@radix.lt>")
    set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Keyboard and mouse sharing solution")
    set(CPACK_PACKAGE_DESCRIPTION [[InputLeap allows you to share one mouse and keyboard between multiple computers.
Work seamlessly across Windows, macOS and Linux.]])
    set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
    set(CPACK_RESOURCE_FILE_README "${CMAKE_SOURCE_DIR}/README.md")

    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        list(APPEND CPACK_GENERATOR "DEB")
        set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
        set(CPACK_DEBIAN_PACKAGE_NAME "input-leap")
        set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${CPACK_PACKAGE_CONTACT}")
        set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
        set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
        set(CPACK_DEBIAN_PACKAGE_HOMEPAGE "https://github.com/input-leap/input-leap")
        set(CPACK_DEBIAN_PACKAGE_RELEASE "1")
        set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
        set(CPACK_DEBIAN_FILE_NAME "DEB-DEFAULT")
    endif()

    include(CPack)
endif()
